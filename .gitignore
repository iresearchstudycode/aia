# TLS certificates — contain private key material, never commit
deploy/certs/

# Auth secrets — TOTP secrets and session signing key, never commit
.env

# Python cache artefacts generated by running tests or the auth service locally
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Node.js — ESLint devDependencies; never commit the dependency tree
node_modules/
