# VPAL Authentication Configuration
# Copy this file to .env and fill in real values before starting the stack.
# .env is gitignored — never commit it.

# -----------------------------------------------------------------------
# Secret key — signs session cookies.  Must be at least 32 characters.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------
SECRET_KEY=change_me_to_a_random_secret_at_least_32_chars

# Session duration (hours).  Default: 8.
SESSION_TTL_HOURS=8

# -----------------------------------------------------------------------
# Setup token — enables the QR-code setup page at:
#   https://localhost/auth/setup?token=<SETUP_TOKEN>
# Remove or leave empty after all users have scanned their QR codes.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
# -----------------------------------------------------------------------
SETUP_TOKEN=change_me_then_remove_after_setup

# -----------------------------------------------------------------------
# Users (up to 5).  Generate a TOTP secret for each user with:
#   python -c "import pyotp; print(pyotp.random_base32())"
# -----------------------------------------------------------------------
USER_1=alice
TOTP_SECRET_1=REPLACEME_BASE32_SECRET_FOR_ALICE

# USER_2=bob
# TOTP_SECRET_2=REPLACEME_BASE32_SECRET_FOR_BOB

# USER_3=carol
# TOTP_SECRET_3=REPLACEME_BASE32_SECRET_FOR_CAROL

# USER_4=dave
# TOTP_SECRET_4=REPLACEME_BASE32_SECRET_FOR_DAVE

# USER_5=eve
# TOTP_SECRET_5=REPLACEME_BASE32_SECRET_FOR_EVE

# -----------------------------------------------------------------------
# VoiceBox proxy — bridges the browser to a local Voicebox desktop app
# (https://localhost/voicebox/speak) so AI responses can optionally be
# spoken through VoiceBox instead of the default (built-in) Piper engine.
# Defaults assume Voicebox is running on the Windows host at its default
# port; only override if you changed Voicebox's port or client-id policy.
# -----------------------------------------------------------------------
# VOICEBOX_URL=http://host.docker.internal:17493
# VOICEBOX_CLIENT_ID=vpal
# VOICEBOX_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------
# Piper TTS — the built-in, fully-offline default speech engine. Nothing
# to configure; the voice model is baked into the vpal-piper-tts image at
# build time. Override only to change the voice or speaking rate.
#   PIPER_VOICE          — voice model basename (default en_US-lessac-medium;
#                          must match the .onnx baked into the image)
#   PIPER_LENGTH_SCALE   — speaking speed, lower = faster (default 1.0)
#   PIPER_MAX_TEXT_CHARS — longest text /piper/speak will synthesise (default 6000)
#   PIPER_MODEL_DIR      — where the .onnx + .onnx.json live in the container
#                          (default /app/voices)
# -----------------------------------------------------------------------
# PIPER_VOICE=en_US-lessac-medium
# PIPER_LENGTH_SCALE=1.0
# PIPER_MAX_TEXT_CHARS=6000

# -----------------------------------------------------------------------
# Document text extraction — self-contained, no external app to configure.
# These only bound worst-case upload size / extracted-text length server-side;
# the frontend's own MAX_DOCUMENT_TEXT_CHARS (config.js) is what actually
# governs how much extracted text gets folded into a chat message.
# -----------------------------------------------------------------------
# MAX_UPLOAD_BYTES=15728640
# MAX_TEXT_CHARS=200000

# -----------------------------------------------------------------------
# Nginx templating (Finding E) — deploy/nginx/nginx.conf is GENERATED from
# deploy/nginx/nginx.conf.template by deploy/nginx/render-nginx-conf.sh.
# The committed nginx.conf is the local-default render; these 8 vars only
# matter when re-rendering for a non-local (cloud) deployment. Defaults below
# reproduce the committed file exactly.  docker-compose still mounts the
# committed nginx.conf — full runtime templating is a deferred follow-up.
# -----------------------------------------------------------------------
# AUTH_UPSTREAM=auth:9000                          # auth service host:port (nginx upstream)
# VOICEBOX_PROXY_UPSTREAM=voicebox-proxy:8002      # voicebox-proxy service host:port
# DOC_EXTRACT_UPSTREAM=doc-extract:8003            # doc-extract service host:port
# PIPER_UPSTREAM=piper-tts:8004                    # piper-tts service host:port
# OLLAMA_UPSTREAM=host.docker.internal:11434       # Ollama host:port for the /ollama/api/chat proxy
# SERVER_NAME=localhost                            # nginx server_name (HTTP + HTTPS blocks)
# SSL_CERT_PATH=/etc/nginx/ssl/localhost.pem       # TLS certificate path inside the container
# SSL_KEY_PATH=/etc/nginx/ssl/localhost-key.pem    # TLS private key path inside the container
