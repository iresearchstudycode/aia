worker_processes  auto;

# Redirect system logs to standard output streams for Docker logging visibility
error_log  /dev/stderr warn;
pid        /var/run/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # Information Masking
    server_tokens off;

    # Send logs to stdout so they appear in 'docker logs'
    access_log  /dev/stdout;

    sendfile        on;
    keepalive_timeout  65;
    keepalive_requests 100;

    # Cap request body for all routes (login, static, auth). Text-only traffic.
    client_max_body_size 1m;

    # Rate limit zone for the Ollama proxy — prevents rapid-fire requests
    limit_req_zone $binary_remote_addr zone=ollama_chat:1m rate=5r/m;

    # Rate limit zone for the Ollama model-list proxy (GET /api/tags) — polled
    # once on page load to populate the model selector, plus the odd manual
    # refresh, so a slightly higher cap than ollama_chat is comfortable.
    limit_req_zone $binary_remote_addr zone=ollama_tags:1m rate=12r/m;

    # Rate limit zone for auth API endpoints — throttles brute-force login
    # attempts and constrains /auth/me polling at the network layer,
    # independent of the in-process per-username lockout in the auth service.
    limit_req_zone $binary_remote_addr zone=auth_api:1m rate=20r/m;

    # Rate limit zone for the VoiceBox speak proxy — one call per AI response
    # (plus occasional manual replays), so a modest cap is enough to stop
    # runaway/abusive use of the host's speakers.
    limit_req_zone $binary_remote_addr zone=voicebox_speak:1m rate=10r/m;

    # Rate limit zone for the Piper TTS speak proxy — one call per AI response
    # (plus occasional manual replays); same modest cap as voicebox_speak.
    limit_req_zone $binary_remote_addr zone=piper_speak:1m rate=10r/m;

    # Rate limit zone for document text extraction — one call per file attached.
    limit_req_zone $binary_remote_addr zone=doc_extract:1m rate=10r/m;

    # Rate limit zone for the consolidated settings service — a handful of
    # GET/PUT/POST calls per session (hydration on page load, plus one per Save).
    limit_req_zone $binary_remote_addr zone=settings:1m rate=30r/m;

    # Return 429 Too Many Requests (not the default 503) when a limit is hit
    limit_req_status 429;

    # Auth service upstream — keepalive pool for efficient auth_request sub-requests
    upstream auth_service {
        server ${AUTH_UPSTREAM};
        keepalive 4;
    }

    # Voicebox proxy upstream — bridges to the local Voicebox app's REST API
    upstream voicebox_service {
        server ${VOICEBOX_PROXY_UPSTREAM};
        keepalive 4;
    }

    # Piper TTS upstream — self-contained (voice model baked into the image),
    # no external host dependency
    upstream piper_service {
        server ${PIPER_UPSTREAM};
        keepalive 8;
    }

    # Document text extraction upstream — self-contained, no external host dependency
    upstream doc_extract_service {
        server ${DOC_EXTRACT_UPSTREAM};
        keepalive 4;
    }

    # Consolidated settings upstream — self-contained (SQLite on a named
    # volume), no external host dependency
    upstream settings_service {
        server ${SETTINGS_UPSTREAM};
        keepalive 16;
    }

    # HTTP Server: Redirect to HTTPS
    server {
        listen 80;
        server_name ${SERVER_NAME};
        return 301 https://$host$request_uri;
    }

    # HTTPS Server
    server {
        listen       443 ssl;
        server_name  ${SERVER_NAME};

        # Hardened Security Headers
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        # style-src carries 'unsafe-inline' solely for KaTeX: it positions glyphs
        # (fraction bars, radicals, sub/superscripts) via computed inline `style`
        # attributes on the spans it generates — there's no CSS-class-only way to
        # do this. script-src stays strict ('self' only, no inline/eval anywhere).
        # media-src 'self' blob: lets the page play the Piper TTS WAV it fetched
        # from /piper/speak via URL.createObjectURL — 'blob:' only permits the
        # page's own client-generated blobs, no external load and no exfil path.
        # Residual risk is bounded by the rest of this policy: default-src 'self',
        # connect-src 'self', and img-src without a wildcard host mean an inline
        # style still can't exfiltrate data or load an external resource.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self'; form-action 'self';" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "geolocation=(), payment=(), usb=(), camera=(), microphone=(self)" always;

        # Linux-compatible volume paths matching your docker setup
        ssl_certificate      ${SSL_CERT_PATH};
        ssl_certificate_key  ${SSL_KEY_PATH};

        # TLS Session and Protocol Hardening
        ssl_session_cache    shared:SSL:10m;
        ssl_session_timeout  10m;
        ssl_protocols        TLSv1.2 TLSv1.3;
        ssl_ciphers          HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers  on;

        # Root static files directory inside standard Nginx container
        root   /usr/share/nginx/html;
        index  index.html index.htm;

        # ------------------------------------------------------------------
        # Auth sub-request endpoint — called internally by auth_request.
        # The 'internal' directive prevents direct browser access.
        # ------------------------------------------------------------------
        location = /auth/verify {
            internal;
            proxy_pass http://auth_service/auth/verify;
            proxy_pass_request_body  off;
            proxy_set_header Content-Length "";
            proxy_set_header Cookie $http_cookie;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
        }

        # ------------------------------------------------------------------
        # Login page and login POST — exact match takes priority over ^~ /auth/
        # so the rate limit applies only here, not to logout or static assets.
        # 20 req/min average; burst of 5 before 429s are returned immediately.
        # ------------------------------------------------------------------
        location = /auth/login {
            limit_req zone=auth_api burst=5 nodelay;
            proxy_pass http://auth_service;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ------------------------------------------------------------------
        # /auth/me — returns the logged-in username for the profile widget.
        # Requires a valid session cookie (auth service enforces 401 without
        # one), so unauthenticated abuse is already constrained.  Rate limit
        # adds network-layer defence-in-depth (20 req/min per IP, burst 10)
        # — adequate for a per-page-load call.
        # ------------------------------------------------------------------
        location = /auth/me {
            limit_req zone=auth_api burst=10 nodelay;
            proxy_pass http://auth_service;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ------------------------------------------------------------------
        # All other /auth/ routes (logout, setup, static CSS) — proxied to
        # the FastAPI auth service without rate limiting.
        # No auth_request here: these must be reachable unauthenticated.
        # ------------------------------------------------------------------
        location ^~ /auth/ {
            proxy_pass http://auth_service;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Named location — target for error_page 401 = @login_redirect
        location @login_redirect {
            return 302 /auth/login;
        }

        # Custom Error Pages
        error_page 400 402 403 404 500 502 503 504 /50x.html;
        location = /50x.html {
            internal;
        }

        # ------------------------------------------------------------------
        # Static files — protected by session authentication.
        # ------------------------------------------------------------------
        location / {
            auth_request /auth/verify;
            error_page 401 = @login_redirect;
            limit_except GET HEAD {
                deny all;
            }
        }

        # ------------------------------------------------------------------
        # Ollama API Reverse Proxy — restricted to the two endpoints the
        # browser needs (/api/chat here, /api/tags below).  Also gated by
        # session authentication. Exact match prevents access to /api/generate,
        # /api/pull, /api/delete, /api/create, /api/copy, /api/push, etc.
        # ------------------------------------------------------------------
        location = /ollama/api/chat {
            auth_request /auth/verify;
            error_page 401 = @login_redirect;

            limit_except POST {
                deny all;
            }
            limit_req zone=ollama_chat burst=5 nodelay;

            # Override global 1m cap: a 10 MB image encodes to ~13.3 MB in base64
            # plus JSON overhead. 20 MB gives headroom for the largest permitted image.
            client_max_body_size 20m;

            # Upstream host:port is set from the OLLAMA_UPSTREAM env var by render-nginx-conf.sh (default host.docker.internal:11434).
            proxy_pass http://${OLLAMA_UPSTREAM}/api/chat;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # Streaming support — disable buffering so chunks reach the browser in real time
            proxy_buffering off;
            proxy_read_timeout 300s;
        }

        # ------------------------------------------------------------------
        # Ollama model list — GET /api/tags, read by the model selector to
        # populate its options. Session-gated and rate-limited like every
        # other route; GET-only (no body) so the global 1m cap and default
        # buffering are fine. This is the only Ollama path allowed besides
        # /api/chat — it exposes model metadata only, never generation.
        # ------------------------------------------------------------------
        location = /ollama/api/tags {
            auth_request /auth/verify;
            error_page 401 = @login_redirect;

            limit_except GET {
                deny all;
            }
            limit_req zone=ollama_tags burst=3 nodelay;

            # Upstream host:port is set from the OLLAMA_UPSTREAM env var by render-nginx-conf.sh (default host.docker.internal:11434).
            proxy_pass http://${OLLAMA_UPSTREAM}/api/tags;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_read_timeout 30s;
        }

        # ------------------------------------------------------------------
        # VoiceBox speak proxy — bridges to the local Voicebox app via the
        # voicebox-proxy service. Also gated by session authentication.
        # Exact match keeps the surface to the single endpoint the browser needs.
        # proxy_read_timeout raised above the default 60s: this call blocks
        # on the voicebox-proxy side for the full synthesis duration (its own
        # httpx timeout is 60s), so nginx must wait at least that long too.
        # ------------------------------------------------------------------
        location = /voicebox/speak {
            auth_request /auth/verify;
            error_page 401 = @login_redirect;

            limit_except POST {
                deny all;
            }
            limit_req zone=voicebox_speak burst=3 nodelay;

            proxy_pass http://voicebox_service;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_read_timeout 90s;
        }

        # ------------------------------------------------------------------
        # VoiceBox audio fetch — serves a previously generated clip so the
        # browser can replay a cache hit itself. GET-only, session-gated,
        # rate-limited under the same zone as /voicebox/speak.
        # ------------------------------------------------------------------
        location ^~ /voicebox/audio/ {
            auth_request /auth/verify;
            error_page 401 = @login_redirect;

            limit_except GET {
                deny all;
            }
            limit_req zone=voicebox_speak burst=3 nodelay;

            proxy_pass http://voicebox_service;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ------------------------------------------------------------------
        # Piper TTS speak proxy — synthesises speech locally and returns raw
        # audio/wav. Session-gated and rate-limited like every other route.
        # Exact match keeps the surface to the single endpoint the browser
        # needs. Buffered proxying is fine (a paragraph of WAV is small) and
        # the default 1m body cap easily covers the tiny JSON request body;
        # proxy_read_timeout is bumped only modestly since CPU synthesis of a
        # few sentences takes at most a few seconds.
        # ------------------------------------------------------------------
        location = /piper/speak {
            auth_request /auth/verify;
            error_page 401 = @login_redirect;

            limit_except POST {
                deny all;
            }
            limit_req zone=piper_speak burst=3 nodelay;

            proxy_pass http://piper_service;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_read_timeout 60s;
        }

        # ------------------------------------------------------------------
        # Document text extraction — accepts a PDF upload, returns extracted
        # text for use as chat context. Also gated by session authentication.
        # client_max_body_size raised to match doc-extract's own 15 MB upload
        # limit (multipart/form-data overhead is negligible next to a PDF).
        # ------------------------------------------------------------------
        location = /doc-extract/extract {
            auth_request /auth/verify;
            error_page 401 = @login_redirect;

            limit_except POST {
                deny all;
            }
            limit_req zone=doc_extract burst=3 nodelay;

            client_max_body_size 15m;

            proxy_pass http://doc_extract_service;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ------------------------------------------------------------------
        # Consolidated settings service — per-user preferences persisted
        # server-side (FastAPI + SQLite on a named volume). Session-gated
        # like every other route. The username recovered by the auth
        # sub-request is captured with auth_request_set and forwarded as
        # X-Auth-User via proxy_set_header — which OVERWRITES any client-
        # supplied X-Auth-User, so the service can trust it. GET reads the
        # resolved settings; PUT/POST mutate them. Bodies are tiny JSON, so
        # the global 1m body cap and default buffering are fine. Two blocks
        # cover the bare /settings and the /settings/... sub-paths
        # (global, persona/{key}, reset).
        # ------------------------------------------------------------------
        location = /settings {
            auth_request /auth/verify;
            error_page 401 = @login_redirect;
            auth_request_set $auth_user $upstream_http_x_auth_user;

            limit_except GET PUT POST {
                deny all;
            }
            limit_req zone=settings burst=10 nodelay;

            proxy_pass http://settings_service;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header X-Auth-User $auth_user;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location ^~ /settings/ {
            auth_request /auth/verify;
            error_page 401 = @login_redirect;
            auth_request_set $auth_user $upstream_http_x_auth_user;

            limit_except GET PUT POST {
                deny all;
            }
            limit_req zone=settings burst=10 nodelay;

            proxy_pass http://settings_service;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header X-Auth-User $auth_user;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
