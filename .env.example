# VPAL Authentication Configuration
# Copy this file to .env and fill in real values before starting the stack.
# .env is gitignored — never commit it.

# -----------------------------------------------------------------------
# Secret key — signs session cookies.  Must be at least 32 characters.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------
SECRET_KEY=change_me_to_a_random_secret_at_least_32_chars

# Session duration (hours).  Default: 8.
SESSION_TTL_HOURS=8

# -----------------------------------------------------------------------
# Setup token — enables the QR-code setup page at:
#   https://localhost/auth/setup?token=<SETUP_TOKEN>
# Remove or leave empty after all users have scanned their QR codes.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
# -----------------------------------------------------------------------
SETUP_TOKEN=change_me_then_remove_after_setup

# -----------------------------------------------------------------------
# Users (up to 5).  Generate a TOTP secret for each user with:
#   python -c "import pyotp; print(pyotp.random_base32())"
# -----------------------------------------------------------------------
USER_1=alice
TOTP_SECRET_1=REPLACEME_BASE32_SECRET_FOR_ALICE

# USER_2=bob
# TOTP_SECRET_2=REPLACEME_BASE32_SECRET_FOR_BOB

# USER_3=carol
# TOTP_SECRET_3=REPLACEME_BASE32_SECRET_FOR_CAROL

# USER_4=dave
# TOTP_SECRET_4=REPLACEME_BASE32_SECRET_FOR_DAVE

# USER_5=eve
# TOTP_SECRET_5=REPLACEME_BASE32_SECRET_FOR_EVE

# -----------------------------------------------------------------------
# VoiceBox proxy — bridges the browser to a local Voicebox desktop app
# (https://localhost/voicebox/speak) so AI responses can optionally be
# spoken through VoiceBox instead of the browser's Web Speech API.
# Defaults assume Voicebox is running on the Windows host at its default
# port; only override if you changed Voicebox's port or client-id policy.
# -----------------------------------------------------------------------
# VOICEBOX_URL=http://host.docker.internal:17493
# VOICEBOX_CLIENT_ID=vpal
# VOICEBOX_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------
# Document text extraction — self-contained, no external app to configure.
# These only bound worst-case upload size / extracted-text length server-side;
# the frontend's own MAX_DOCUMENT_TEXT_CHARS (config.js) is what actually
# governs how much extracted text gets folded into a chat message.
# -----------------------------------------------------------------------
# MAX_UPLOAD_BYTES=15728640
# MAX_TEXT_CHARS=200000
